entrypoint = "index.html"
modules = ["web", "nodejs-20", "go-1.25", "python-base-3.13"]

[nix]
channel = "stable-24_11"
packages = ["static-web-server"]

[deployment]
deploymentTarget = "static"
run = ["node", "admin/server.js"]
publicDir = "/"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Admin server"

[[workflows.workflow]]
name = "Admin server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh admin/start-all.sh"
waitForPort = 3001

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000

[[ports]]
localPort = 80
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 8098
externalPort = 3000
